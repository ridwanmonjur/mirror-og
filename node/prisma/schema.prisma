model wallet_topups {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  amount     Decimal  @db.Decimal(10, 2)
  created_at DateTime @default(now()) @db.Timestamp(0)
  user_id    BigInt   @db.UnsignedBigInt
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "wallet_topups_user_id_foreign")

  @@index([user_id], map: "wallet_topups_user_id_foreign")
}

model weekly_task_executions {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  executed_at DateTime @db.Timestamp(0)
}

model withdrawals {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt    @db.UnsignedBigInt
  withdrawal   Decimal   @db.Decimal(10, 2)
  status       String    @default("pending") @db.VarChar(255)
  requested_at DateTime? @db.Timestamp(0)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "withdrawals_user_id_foreign")

  @@index([user_id], map: "withdrawals_user_id_index")
}

