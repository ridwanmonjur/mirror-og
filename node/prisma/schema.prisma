generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model fa_links {
  id                       BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                  BigInt    @db.UnsignedBigInt
  withdrawal_history_token String    @unique(map: "2fa_links_withdrawal_history_token_unique") @db.VarChar(64)
  expires_at               DateTime  @db.Timestamp(0)
  created_at               DateTime? @db.Timestamp(0)
  updated_at               DateTime? @db.Timestamp(0)
  users                    users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "2fa_links_user_id_foreign")

  @@index([user_id], map: "2fa_links_user_id_foreign")
  @@index([withdrawal_history_token, expires_at], map: "2fa_links_withdrawal_history_token_expires_at_index")
  @@map("2fa_links")
}

model achievements {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  title         String      @unique(map: "achievements_title_unique") @db.VarChar(255)
  description   String      @db.Text
  join_event_id BigInt      @db.UnsignedBigInt
  created_at    DateTime    @default(now()) @db.Timestamp(0)
  join_events   join_events @relation(fields: [join_event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "achievements_join_event_id_foreign")

  @@index([join_event_id], map: "achievements_join_event_id_foreign")
}

model activity_logs {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  action       String    @db.VarChar(255)
  image        String?   @db.VarChar(255)
  log          String    @db.Text
  subject_type String    @db.VarChar(255)
  subject_id   BigInt    @db.UnsignedBigInt
  object_type  String?   @db.VarChar(255)
  object_id    BigInt?   @db.UnsignedBigInt
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)

  @@index([object_type, object_id], map: "activity_logs_object_type_object_id_index")
  @@index([subject_type, subject_id], map: "activity_logs_subject_type_subject_id_index")
}

model awards {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  title          String?          @db.VarChar(255)
  image          String?          @db.VarChar(255)
  description    String?          @db.VarChar(255)
  created_at     DateTime?        @db.Timestamp(0)
  updated_at     DateTime?        @db.Timestamp(0)
  awards_results awards_results[]
}

model awards_results {
  join_events_id BigInt      @db.UnsignedBigInt
  award_id       BigInt      @db.UnsignedBigInt
  team_id        BigInt      @db.UnsignedBigInt
  id             BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  awards         awards      @relation(fields: [award_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "awards_results_award_id_foreign")
  join_events    join_events @relation(fields: [join_events_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "awards_results_join_events_id_foreign")
  teams          teams       @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "awards_results_team_id_foreign")

  @@unique([award_id, join_events_id], map: "awards_results_award_id_join_events_id_unique")
  @@index([join_events_id], map: "awards_results_join_events_id_foreign")
  @@index([team_id], map: "awards_results_team_id_foreign")
}

model blocks {
  id                                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                             BigInt    @db.UnsignedBigInt
  blocked_user_id                     BigInt    @db.UnsignedBigInt
  created_at                          DateTime? @db.Timestamp(0)
  updated_at                          DateTime? @db.Timestamp(0)
  users_blocks_blocked_user_idTousers users     @relation("blocks_blocked_user_idTousers", fields: [blocked_user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "blocks_blocked_user_id_foreign")
  users_blocks_user_idTousers         users     @relation("blocks_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "blocks_user_id_foreign")

  @@unique([user_id, blocked_user_id], map: "blocks_user_id_blocked_user_id_unique")
  @@index([blocked_user_id], map: "blocks_blocked_user_id_foreign")
}

model bracket_deadline_setup {
  id              BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  tier_id         BigInt      @db.UnsignedBigInt
  type_id         BigInt?     @db.UnsignedBigInt
  deadline_config String      @db.LongText
  event_tier      event_tier  @relation(fields: [tier_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bracket_deadline_setup_tier_id_foreign")
  event_type      event_type? @relation(fields: [type_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bracket_deadline_setup_type_id_foreign")

  @@index([tier_id], map: "bracket_deadline_setup_tier_id_foreign")
  @@index([type_id], map: "bracket_deadline_setup_type_id_foreign")
}

model bracket_deadlines {
  id               BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  stage            String        @db.VarChar(255)
  inner_stage      String        @db.VarChar(255)
  start_date       DateTime      @db.DateTime(0)
  end_date         DateTime      @db.DateTime(0)
  created_at       DateTime      @db.DateTime(0)
  event_details_id BigInt        @db.UnsignedBigInt
  event_details    event_details @relation(fields: [event_details_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bracket_deadlines_event_details_id_foreign")

  @@unique([event_details_id, stage, inner_stage], map: "bracket_deadlines_event_details_id_stage_inner_stage_unique")
}

model brackets {
  id                             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  order                          Int           @db.UnsignedInt
  team1_id                       BigInt?       @db.UnsignedBigInt
  team2_id                       BigInt?       @db.UnsignedBigInt
  event_details_id               BigInt        @db.UnsignedBigInt
  team1_position                 String?       @db.VarChar(255)
  team2_position                 String?       @db.VarChar(255)
  stage_name                     String?       @db.VarChar(255)
  inner_stage_name               String?       @db.VarChar(255)
  created_at                     DateTime?     @db.Timestamp(0)
  updated_at                     DateTime?     @db.Timestamp(0)
  event_details                  event_details @relation(fields: [event_details_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "matches_event_details_id_foreign")
  teams_brackets_team1_idToteams teams?        @relation("brackets_team1_idToteams", fields: [team1_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "matches_team1_id_foreign")
  teams_brackets_team2_idToteams teams?        @relation("brackets_team2_idToteams", fields: [team2_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "matches_team2_id_foreign")

  @@index([event_details_id], map: "matches_event_details_id_foreign")
  @@index([team1_id], map: "matches_team1_id_foreign")
  @@index([team2_id], map: "matches_team2_id_foreign")
}

model brackets_setup {
  id                   BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  event_tier_id        BigInt     @db.UnsignedBigInt
  team1_position       String?    @db.VarChar(255)
  stage_name           String?    @db.VarChar(255)
  inner_stage_name     String?    @db.VarChar(255)
  order                String?    @db.VarChar(255)
  team2_position       String?    @db.VarChar(255)
  winner_next_position String?    @db.VarChar(255)
  loser_next_position  String?    @db.VarChar(255)
  event_tier           event_tier @relation(fields: [event_tier_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "brackets_setup_event_tier_id_foreign")

  @@index([event_tier_id], map: "brackets_setup_event_tier_id_index")
}

model captains {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  team_member_id BigInt       @db.UnsignedBigInt
  teams_id       BigInt       @db.UnsignedBigInt
  team_members   team_members @relation(fields: [team_member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "captains_team_member_id_foreign")
  teams          teams        @relation(fields: [teams_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "captains_teams_id_foreign")

  @@index([team_member_id], map: "captains_team_member_id_foreign")
  @@index([teams_id], map: "captains_teams_id_foreign")
}

model cart_item_product_variants {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  cart_item_id     BigInt           @db.UnsignedBigInt
  variant_id       BigInt           @db.UnsignedBigInt
  created_at       DateTime?        @db.Timestamp(0)
  updated_at       DateTime?        @db.Timestamp(0)
  cart_items       cart_items       @relation(fields: [cart_item_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cart_item_product_variants_cart_item_id_foreign")
  product_variants product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cart_item_product_variants_variant_id_foreign")

  @@unique([cart_item_id, variant_id], map: "cart_item_product_variants_cart_item_id_variant_id_unique")
  @@index([variant_id], map: "cart_item_product_variants_variant_id_foreign")
}

model cart_items {
  id                         BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  cart_id                    BigInt                       @db.UnsignedBigInt
  product_id                 Int                          @db.UnsignedInt
  quantity                   Int
  subtotal                   Decimal                      @db.Decimal(8, 2)
  created_at                 DateTime?                    @db.Timestamp(0)
  updated_at                 DateTime?                    @db.Timestamp(0)
  cart_item_product_variants cart_item_product_variants[]
  final_carts                final_carts                  @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cart_items_cart_id_foreign")
  products                   products                     @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cart_items_product_id_foreign")

  @@index([cart_id], map: "cart_items_cart_id_foreign")
  @@index([product_id], map: "cart_items_product_id_foreign")
}

model categories {
  id               Int          @id @default(autoincrement()) @db.UnsignedInt
  parent_id        Int?         @db.UnsignedInt
  order            Int          @default(1)
  name             String       @db.VarChar(255)
  slug             String       @unique(map: "categories_slug_unique") @db.VarChar(255)
  created_at       DateTime?    @db.Timestamp(0)
  updated_at       DateTime?    @db.Timestamp(0)
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], map: "categories_parent_id_foreign")
  other_categories categories[] @relation("categoriesTocategories")

  @@index([parent_id], map: "categories_parent_id_foreign")
}

model category {
  id               Int                @id @default(autoincrement()) @db.UnsignedInt
  name             String             @unique(map: "category_name_unique") @db.VarChar(255)
  slug             String             @unique(map: "category_slug_unique") @db.VarChar(255)
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  category_product category_product[]
}

model category_product {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  product_id  Int?      @db.UnsignedInt
  category_id Int?      @db.UnsignedInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  category    category? @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "category_product_category_id_foreign")
  products    products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "category_product_product_id_foreign")

  @@index([category_id], map: "category_product_category_id_foreign")
  @@index([product_id], map: "category_product_product_id_foreign")
}

model conversations {
  id                                      BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  status                                  conversations_status @default(request)
  created_at                              DateTime?            @db.Timestamp(0)
  updated_at                              DateTime?            @db.Timestamp(0)
  user1_id                                BigInt               @db.UnsignedBigInt
  user2_id                                BigInt               @db.UnsignedBigInt
  initiator_id                            BigInt               @db.UnsignedBigInt
  users_conversations_initiator_idTousers users                @relation("conversations_initiator_idTousers", fields: [initiator_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "conversations_initiator_id_foreign")
  users_conversations_user1_idTousers     users                @relation("conversations_user1_idTousers", fields: [user1_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "conversations_user1_id_foreign")
  users_conversations_user2_idTousers     users                @relation("conversations_user2_idTousers", fields: [user2_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "conversations_user2_id_foreign")

  @@index([initiator_id], map: "conversations_initiator_id_foreign")
  @@index([user1_id], map: "conversations_user1_id_foreign")
  @@index([user2_id], map: "conversations_user2_id_foreign")
}

model countries_and_regions {
  id         BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  name       String                     @unique(map: "countries_and_regions_name_unique") @db.VarChar(255)
  emoji_flag String                     @db.VarChar(255)
  type       countries_and_regions_type @default(country)
  sort_order Int                        @default(1000)

  @@index([name, type], map: "countries_and_regions_name_type_index")
  @@index([sort_order], map: "countries_and_regions_sort_order_index")
  @@index([type], map: "countries_and_regions_type_index")
}

model coupons {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  code        String    @unique(map: "coupons_code_unique") @db.VarChar(255)
  type        String    @db.VarChar(255)
  value       Int?
  percent_off Int?
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model csv_passwords {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  password String @db.VarChar(255)
}

model daily_command_errors {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  class_name  String    @db.VarChar(255)
  error_date  DateTime  @db.Date
  error_count Int       @default(1)
  email_sent  Boolean   @default(false)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)

  @@unique([class_name, error_date], map: "daily_command_errors_class_name_error_date_unique")
  @@index([class_name], map: "daily_command_errors_class_name_index")
  @@index([error_date], map: "daily_command_errors_error_date_index")
}

model disputes {
  id                                      BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  report_id                               String        @db.VarChar(255)
  match_number                            String        @db.VarChar(255)
  event_id                                BigInt        @db.UnsignedBigInt
  dispute_userId                          BigInt        @db.UnsignedBigInt
  dispute_teamId                          BigInt        @db.UnsignedBigInt
  dispute_teamNumber                      String        @db.VarChar(255)
  dispute_reason                          String        @db.VarChar(255)
  dispute_description                     String?       @db.Text
  response_userId                         BigInt?       @db.UnsignedBigInt
  response_teamId                         BigInt?       @db.UnsignedBigInt
  response_teamNumber                     String?       @db.VarChar(255)
  response_explanation                    String?       @db.Text
  resolution_winner                       BigInt?       @db.UnsignedBigInt
  resolution_resolved_by                  BigInt?       @db.UnsignedBigInt
  created_at                              DateTime?     @db.Timestamp(0)
  updated_at                              DateTime?     @db.Timestamp(0)
  teams_disputes_dispute_teamIdToteams    teams         @relation("disputes_dispute_teamIdToteams", fields: [dispute_teamId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "disputes_dispute_teamid_foreign")
  users_disputes_dispute_userIdTousers    users         @relation("disputes_dispute_userIdTousers", fields: [dispute_userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "disputes_dispute_userid_foreign")
  event_details                           event_details @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "disputes_event_id_foreign")
  teams_disputes_resolution_winnerToteams teams?        @relation("disputes_resolution_winnerToteams", fields: [resolution_winner], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "disputes_resolution_winner_foreign")
  teams_disputes_response_teamIdToteams   teams?        @relation("disputes_response_teamIdToteams", fields: [response_teamId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "disputes_response_teamid_foreign")
  users_disputes_response_userIdTousers   users?        @relation("disputes_response_userIdTousers", fields: [response_userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "disputes_response_userid_foreign")

  @@unique([event_id, match_number, report_id], map: "disputes_event_id_match_number_report_id_unique")
  @@index([dispute_teamId], map: "disputes_dispute_teamid_foreign")
  @@index([dispute_userId], map: "disputes_dispute_userid_foreign")
  @@index([resolution_winner], map: "disputes_resolution_winner_foreign")
  @@index([response_teamId], map: "disputes_response_teamid_foreign")
  @@index([response_userId], map: "disputes_response_userid_foreign")
}

model event_categories {
  id               BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  player_per_team  Int             @default(5)
  games_per_match  Int             @default(3)
  gameTitle        String?         @db.VarChar(255)
  gameIcon         String?         @db.VarChar(255)
  gameUrl          String?         @db.VarChar(500)
  url              String?         @db.VarChar(500)
  eventDefinitions String?         @db.VarChar(255)
  user_id          BigInt?         @db.UnsignedBigInt
  created_at       DateTime?       @db.Timestamp(0)
  updated_at       DateTime?       @db.Timestamp(0)
  users            users?          @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "event_categories_user_id_foreign")
  event_details    event_details[]

  @@index([user_id], map: "event_categories_user_id_foreign")
}

model event_create_coupon {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String?   @db.VarChar(255)
  coupon     String?   @db.VarChar(255)
  type       String?   @db.VarChar(255)
  amount     Float?
  startDate  DateTime? @db.Date
  endDate    DateTime? @db.Date
  startTime  DateTime? @db.Time(0)
  endTime    DateTime? @db.Time(0)
  isEnforced Boolean?
}

model event_details {
  id                     BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  eventDefinitions       String?             @db.VarChar(255)
  eventName              String?             @db.VarChar(255)
  slug                   String?             @unique(map: "event_details_slug_unique") @db.VarChar(255)
  startDate              DateTime?           @db.Date
  endDate                DateTime?           @db.Date
  startTime              DateTime?           @db.Time(0)
  endTime                DateTime?           @db.Time(0)
  eventDescription       String?             @db.Text
  eventBanner            String?             @db.VarChar(255)
  eventTags              String?             @db.VarChar(255)
  status                 String?             @db.VarChar(255)
  venue                  String?             @db.VarChar(255)
  sub_action_public_date String?             @db.VarChar(255)
  sub_action_public_time String?             @db.VarChar(255)
  sub_action_private     String?             @db.VarChar(255)
  user_id                BigInt              @db.UnsignedBigInt
  created_at             DateTime?           @db.Timestamp(0)
  updated_at             DateTime?           @db.Timestamp(0)
  event_type_id          BigInt?             @db.UnsignedBigInt
  event_tier_id          BigInt?             @db.UnsignedBigInt
  event_category_id      BigInt?             @db.UnsignedBigInt
  willNotify             Boolean             @default(true)
  payment_transaction_id BigInt?             @db.UnsignedBigInt
  bracket_deadlines      bracket_deadlines[]
  brackets               brackets[]
  disputes               disputes[]
  event_categories       event_categories?   @relation(fields: [event_category_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_details_event_category_id_foreign")
  event_tier             event_tier?         @relation(fields: [event_tier_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_details_event_tier_id_foreign")
  event_type             event_type?         @relation(fields: [event_type_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_details_event_type_id_foreign")
  organizer_payments     organizer_payments? @relation(fields: [payment_transaction_id], references: [id], onUpdate: Restrict, map: "event_details_payment_transaction_id_foreign")
  users                  users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_details_user_id_foreign")
  event_invitations      event_invitations[]
  event_signup_dates     event_signup_dates?
  join_events            join_events[]
  likes                  likes[]
  org_event_coupons      org_event_coupons[]

  @@index([event_category_id], map: "event_details_event_category_id_foreign")
  @@index([event_tier_id], map: "event_details_event_tier_id_foreign")
  @@index([event_type_id], map: "event_details_event_type_id_foreign")
  @@index([payment_transaction_id], map: "event_details_payment_transaction_id_foreign")
  @@index([user_id], map: "event_details_user_id_foreign")
}

model event_invitations {
  id                                                 BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  organizer_user_id                                  BigInt?        @db.UnsignedBigInt
  event_id                                           BigInt?        @db.UnsignedBigInt
  participant_user_id                                BigInt?        @db.UnsignedBigInt
  created_at                                         DateTime?      @db.Timestamp(0)
  updated_at                                         DateTime?      @db.Timestamp(0)
  team_id                                            BigInt?        @db.UnsignedBigInt
  event_details                                      event_details? @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_invitations_event_id_foreign")
  users_event_invitations_organizer_user_idTousers   users?         @relation("event_invitations_organizer_user_idTousers", fields: [organizer_user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_invitations_organizer_id_foreign")
  users_event_invitations_participant_user_idTousers users?         @relation("event_invitations_participant_user_idTousers", fields: [participant_user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_invitations_participant_id_foreign")
  teams                                              teams?         @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_invitations_team_id_foreign")

  @@index([event_id], map: "event_invitations_event_id_foreign")
  @@index([organizer_user_id], map: "event_invitations_organizer_id_foreign")
  @@index([participant_user_id], map: "event_invitations_participant_id_foreign")
  @@index([team_id], map: "event_invitations_team_id_foreign")
}

model event_join_results {
  join_events_id BigInt      @db.UnsignedBigInt
  position       Int
  id             BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  prize_sum      Decimal?    @db.Decimal(10, 2)
  played         Int         @default(0) @db.UnsignedInt
  won            Int         @default(0) @db.UnsignedInt
  draw           Int         @default(0) @db.UnsignedInt
  points         Int         @default(0) @db.UnsignedInt
  lost           Int         @default(0) @db.UnsignedInt
  join_events    join_events @relation(fields: [join_events_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_join_results_join_events_id_foreign")

